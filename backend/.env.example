# --- services ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=datapilot
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- embeddings and storage ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=./storage/chroma
UPLOAD_DIR=./storage/uploads
CORS_ORIGINS=http://localhost:5173

# --- behaviour ---
# What happens when row-level sensitive data (emails, phones, salaries, cards...) reaches an answer:
#   ask   = pause and let a human choose mask / exclude / show   (default)
#   mask  = always mask automatically, never pause
#   allow = no check
SENSITIVE_POLICY=ask
MAX_AGENT_STEPS=5
MEMORY_TOP_K=3
MEMORY_MAX_DISTANCE=1.0
